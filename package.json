                "default": "./dist/esm/api/resources/corporateActions/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/corporateActions/exports.d.ts",
                "default": "./dist/cjs/api/resources/corporateActions/exports.js"
            },
            "default": "./dist/cjs/api/resources/corporateActions/exports.js"
        },
        "./entities": {
            "import": {
                "types": "./dist/esm/api/resources/entities/exports.d.mts",
                "default": "./dist/esm/api/resources/entities/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/entities/exports.d.ts",
                "default": "./dist/cjs/api/resources/entities/exports.js"
            },
            "default": "./dist/cjs/api/resources/entities/exports.js"
        },
        "./accounts": {
            "import": {
                "types": "./dist/esm/api/resources/accounts/exports.d.mts",
                "default": "./dist/esm/api/resources/accounts/exports.mjs"
