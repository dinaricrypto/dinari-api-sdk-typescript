            "import": {
                "types": "./dist/esm/api/resources/orderRequests/exports.d.mts",
                "default": "./dist/esm/api/resources/orderRequests/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/orderRequests/exports.d.ts",
                "default": "./dist/cjs/api/resources/orderRequests/exports.js"
            },
            "default": "./dist/cjs/api/resources/orderRequests/exports.js"
        },
        "./managedOrders": {
            "import": {
                "types": "./dist/esm/api/resources/managedOrders/exports.d.mts",
