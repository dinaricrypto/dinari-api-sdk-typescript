{
    "name": "@dinari/api-sdk",
    "version": "1.0.0",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dinaricrypto/dinari-api-sdk-typescript.git"
    },
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./serialization": {
            "import": {
                "types": "./dist/esm/serialization/index.d.mts",
                "default": "./dist/esm/serialization/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/serialization/index.d.ts",
                "default": "./dist/cjs/serialization/index.js"
            },
            "default": "./dist/cjs/serialization/index.js"
        },
        "./marketData": {
            "import": {
                "types": "./dist/esm/api/resources/marketData/exports.d.mts",
                "default": "./dist/esm/api/resources/marketData/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/marketData/exports.d.ts",
                "default": "./dist/cjs/api/resources/marketData/exports.js"
            },
            "default": "./dist/cjs/api/resources/marketData/exports.js"
        },
        "./corporateActions": {
