            "default": "./dist/cjs/api/resources/accounts/exports.js"
        },
        "./kyc": {
            "import": {
                "types": "./dist/esm/api/resources/kyc/exports.d.mts",
                "default": "./dist/esm/api/resources/kyc/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/kyc/exports.d.ts",
                "default": "./dist/cjs/api/resources/kyc/exports.js"
            },
            "default": "./dist/cjs/api/resources/kyc/exports.js"
        },
        "./orders": {
            "import": {
                "types": "./dist/esm/api/resources/orders/exports.d.mts",
